# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Binary files that should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
